  "narrative": {
    "northStar": "FoodDelivery — clear shopping",
    "overview": "A concise shopping interface: real food photography, clear prices and available stock. Emerald carries navigation and shopping feedback; amber marks the main shopping action. Short Vietnamese labels replace promotional paragraphs.\n\nThis records the redesigned homepage, shared public header/footer and shared catalog primitives used by the product list (/products) and search (/search). Product details, cart, checkout and admin interiors retain their existing styling. Global legacy tokens remain intact: root primary is Emerald-500, while these surfaces use its existing darker Emerald-700 token for readable controls and prices.",
    "keyCharacteristics": [
      "Concise Vietnamese copy",
      "Real catalog photography and prices",
      "Flat white surfaces and fine borders"
    ],
    "rules": [
      {
        "name": "The Content First Rule",
        "body": "Use photographs, prices and stock to explain the offer; avoid long promotional sections.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Shared product cards use a fine border without decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve FoodDelivery, emerald/amber and Inter.",
      "Do show real catalog data and explicit loading, error, empty and unavailable states.",
      "Do keep mobile search and support accessible without covering purchasing controls."
    ],
    "donts": [
      "Don't replace API failures with purchasable sample products.",
      "Don't add unsupported ratings, certifications or delivery promises.",
      "Don't extend the shared shopping styling to remaining legacy interiors without reviewing them."
    ]
  }
